# ---------------------------------------------------------------------------
# XLRI Secure Notes Portal - environment variables
# Copy to .env.local for local dev; set the same keys in Vercel Project Settings.
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service role key - SERVER ONLY. Never expose to the browser / never prefix NEXT_PUBLIC.
# Used by API routes for admin storage ops and best-effort deletion of out-of-domain users.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL of the deployment (used to build the OAuth redirect).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only this email domain may authenticate. Enforced in the UI, the API, and a DB trigger.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=astra.xlri.ac.in
ALLOWED_EMAIL_DOMAIN=astra.xlri.ac.in

# --- Google OAuth ---
# These are configured in the Supabase Dashboard (Authentication -> Providers -> Google),
# NOT read by this app directly. Listed here so infra/setup has one checklist.
# GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxxxxxxx

# --- Session policy (hours) - optional overrides ---
NEXT_PUBLIC_INACTIVITY_LOGOUT_HOURS=4
NEXT_PUBLIC_ABSOLUTE_SESSION_HOURS_DEFAULT=4
NEXT_PUBLIC_ABSOLUTE_SESSION_HOURS_STAY=48
